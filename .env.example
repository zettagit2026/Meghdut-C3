# Copy this file to `.env` (same directory as docker-compose.yml) and fill in
# real values. `.env` is gitignored — never commit real secrets.
#
# Generate a strong JWT secret with:  openssl rand -hex 32

JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Shared secret gating POST /api/iff/beacons/ingest. This is a SEPARATE trust
# boundary from JWT_SECRET/ordinary login -- it must be known ONLY to the
# field-bridge/iff_beacon_bridge.py process (set the SAME value in that
# bridge's own .env as IFF_BRIDGE_API_KEY). Without this, any authenticated
# console user could fabricate a "verified friendly" IFF claim and suppress
# a real hostile-detection warning. Generate with: openssl rand -hex 32
IFF_BRIDGE_API_KEY=
# Shared bridge-identity secret gating the diagnostic bridge_hello TX-consumer
# registration on ws /api/ws/mavlink. A real TX bridge (rf-bridge/
# mavlink_bridge.py, field-bridge/jam_bridge.py) presents this to prove it is a
# bridge — not a browser/console session — before the backend will trust its
# self-advertisement and suppress the "NO TX BRIDGE SUBSCRIBED" warning. Set the
# SAME value here AND in each TX-bridge host's .env (rf-bridge/.env,
# field-bridge/.env) as CEMA_BRIDGE_TOKEN. Diagnostic-only: it NEVER gates or
# authorizes a transmit. OPTIONAL — leave unset to disable TX-consumer
# registration (the honest signal then always warns "no TX bridge subscribed",
# which over-warns but never falsely reassures). Generate with: openssl rand -hex 32
CEMA_BRIDGE_TOKEN=
# Comma-separated list of allowed frontend origins (no wildcards in prod).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Wi-Fi Environment (RF situational-awareness) panel -- READ ONLY ---------
# GET /api/wifi-environment proxies a running Kismet server's REST API
# server-side so the operator can SEE the ambient Wi-Fi AP picture. The apikey
# is used ONLY backend->Kismet and NEVER reaches the browser. This is a pure
# visibility layer: it creates no detections and can never engage/target an AP.
# Optional -- leave KISMET_URL blank to disable (the panel then shows a "not
# configured" state). Point these at the SAME Kismet server the field-bridge
# kismet_bridge already polls (see field-bridge/.env KISMET_URL/KISMET_APIKEY).
KISMET_URL=
KISMET_APIKEY=
