[Unit]
Description=CEMA cUAS - OPERATOR jam bridge (operator's own jammer, WS-driven, bounded burst only)
After=network-online.target docker.service
Wants=network-online.target

# This bridge is a COMPANION of cema-jam-bridge.service, not an independently
# started unit. The GUI "Bring TX Online" starts cema-jam-bridge via the root
# host-helper; that unit's Wants=+Before= pulls this one up alongside it. The
# PartOf= below binds this unit's lifecycle to cema-jam-bridge so that a stop
# or restart of cema-jam-bridge propagates here — i.e. "Stand Down"
# (`systemctl stop cema-jam-bridge`) stops this operator bridge too. The After=
# keeps ordering deterministic (jam-bridge settles first). NOTE: PartOf only
# propagates stop/restart, not start; the start side comes from the jam-bridge
# unit's Wants=. The operator must never start this unit from a terminal, and
# its [Install] below is scoped to cema-jam-bridge (NOT multi-user.target) so it
# does not auto-start at boot independently of TX-online.
PartOf=cema-jam-bridge.service
After=cema-jam-bridge.service

[Service]
Type=simple
# Change these three (User/WorkingDirectory/EnvironmentFile path) to match your
# deployment — same convention as field-bridge/cema-jam-bridge.service. There is
# deliberately only ONE copy of this unit in the repo; do not fork per-host
# copies with hardcoded paths/users baked in. Keep host-specific values out of
# this file — they belong in the EnvironmentFile below.
User=biswajit
WorkingDirectory=/CEMA/joydipdemo/field-bridge

# This bridge runs the OPERATOR'S OWN jammer (their unmodified files under
# OPERATOR_JAM_DIR) through the SAME governed spine as cema-jam-bridge.service.
# See field-bridge/operator_jam_bridge.py + operator_jam_wrapper.py.
#
# The EnvironmentFile must define at minimum (same as the MEGHDUT jam bridge):
#   CEMA_API_URL=http://localhost:8001
#   CEMA_EMAIL=operator@meghaduta.mil
#   CEMA_PASSWORD=<this host's current admin password>
# and SHOULD define (to enable the honest "TX bridge subscribed" signal):
#   CEMA_BRIDGE_TOKEN=<same shared secret as the backend + other bridge .env>
#
# TWO operator-jam-specific values are REQUIRED for this bridge to actually
# radiate the operator's jammer:
#   HACKRF_TX_SERIAL=<TX unit serial>   # e.g. the ...930c TX unit. The wrapper
#                                       # FAILS CLOSED without it — it will NOT
#                                       # fall back to index-based "hackrf=0"
#                                       # (which could key the RX detection
#                                       # radio). This is the one device-pin
#                                       # safety override the wrapper imposes.
#   OPERATOR_JAM_DIR=/CEMA/operator-jam # directory holding the operator's
#                                       # UNMODIFIED files (cema_base.py, etc.).
#                                       # These are imported as-is and NEVER
#                                       # modified or copied into the repo.
#
# =====================================================================
# CEMA_AUTHORIZED_RANGE — DELIBERATELY NOT SET IN THIS UNIT FILE.
# =====================================================================
# Identical to cema-jam-bridge.service: the live range-authorization lease is
# an explicit, GUI-driven, auto-expiring per-deployment decision (checked LIVE
# by the shared JamBridge spine at the moment of transmission via GET
# /api/range-authorization/status?effect=jam). Do NOT bake any static
# authorization into this committed unit, a shared default .env, or any image —
# doing so would silently turn every deployment into a live transmitter.
EnvironmentFile=/CEMA/joydipdemo/field-bridge/.env

# INTERPRETER REQUIREMENT (resolved at deploy, do NOT hardcode a wrong path):
# operator_jam_bridge.py runs the operator's own GNU Radio flowgraph via
# operator_jam_wrapper.py, so the interpreter named in ExecStart MUST be able to
# import BOTH:
#   1) GNU Radio + gr-osmosdr   (`import gnuradio`, `import osmosdr`) — usually
#      provided by the SYSTEM python where GNU Radio is installed, NOT a plain
#      pip venv; and
#   2) the field-bridge deps used by jam_bridge.py / JamBridge
#      (requests, websocket-client, etc.).
# If the ExecStart python can see only one of these, the unit fails at import
# (the wrapper fails closed when GNU Radio / gr-osmosdr is missing). The
# resolved interpreter this deployment uses is /CEMA/operator-jam-venv — a
# dedicated venv created with --system-site-packages over a GNU-Radio-enabled
# system python (so `import gnuradio` / `import osmosdr` resolve), plus the
# field-bridge deps installed into it (requests, websocket-client, numpy). Do
# NOT point ExecStart back at a plain pip venv that cannot see GNU Radio.
ExecStart=/CEMA/operator-jam-venv/bin/python -u operator_jam_bridge.py
Restart=always
RestartSec=3
StandardOutput=append:/CEMA/joydipdemo/field-bridge/operator_jam_bridge.log
StandardError=append:/CEMA/joydipdemo/field-bridge/operator_jam_bridge.log

[Install]
# Scoped to the jam-bridge coupling, NOT multi-user.target: `systemctl enable`
# installs this only into cema-jam-bridge.service.wants/, so it never comes up
# on its own at boot — it is brought up only as a companion of cema-jam-bridge
# when the GUI brings TX online (see the [Unit] Wants=/PartOf= coupling above).
WantedBy=cema-jam-bridge.service
