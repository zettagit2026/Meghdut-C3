[Unit]
Description=CEMA cUAS - gated ML classify-and-ingest bridge (RX only, no transmission, ADDITIONAL signal on top of hackrf_rx.py's RSSI heuristics -- NOT a replacement)
After=network-online.target docker.service cema-hackrf-rx.service
Wants=network-online.target
# Restart-limit hardening (same rationale as cema-mavlink-sniffer.service,
# task #80): RX-only, no TX, nothing else depends on this holding a lock, so
# "keep retrying forever" through transient hiccups (device contention with
# cema-hackrf-rx.service, USB re-enumeration, etc.) is the correct posture.
# Default StartLimitBurst=5/StartLimitIntervalSec=10s can trip permanently,
# requiring a manual reset-failed. Widen the window/burst and disable
# give-up behavior.
StartLimitIntervalSec=300
StartLimitBurst=20
StartLimitAction=none

[Service]
Type=simple
# Change these three (User/WorkingDirectory/EnvironmentFile path) to match your
# deployment — same convention as cema-hackrf-rx.service / cema-mavlink-sniffer.service.
# There is deliberately only ONE copy of this unit in the repo; do not fork
# per-host copies with hardcoded paths/users baked in. Keep host-specific
# values out of this file — they belong in the EnvironmentFile below.
User=biswajit
WorkingDirectory=/CEMA/joydipdemo/field-bridge

# Credentials and console URL are NOT hardcoded here. They are supplied via
# EnvironmentFile, which must define at minimum:
#   CEMA_API_URL=http://localhost:8001
#   CEMA_EMAIL=operator@meghaduta.mil
#   CEMA_PASSWORD=<this host's current admin password>
# Optional overrides (see ml_classify_bridge.py module docstring for defaults
# and full explanation of each):
#   CEMA_ML_CHECKPOINT=/CEMA/joydipdemo/field-bridge/models/resnet18_leesburg_split_0.02_1_current.pt
#   (task #133: must point at a persistent path, never /tmp -- the checkpoint
#   is wiped on every reboot if left at the ephemeral /tmp default.)
#   CEMA_ML_INTERVAL_S=12
#   CEMA_ML_SAMPLE_RATE_HZ=10e6
#   CEMA_ML_CAPTURE_S=0.3
#   CEMA_ML_OFFSET_S=0.05
# Point this at either the project-root .env or a dedicated field-bridge/.env.
# This file must be created per-deployment; it is not committed to the repo.
# Restrict its permissions: chmod 600.
EnvironmentFile=/CEMA/joydipdemo/field-bridge/.env

# This script requires torch (see gamutrf_infer.py), which lives in this
# project's dedicated field-bridge venv, not system Python. Task #133: an
# earlier version of this unit pointed ExecStart at /usr/bin/python3, which
# crash-looped with ModuleNotFoundError: No module named 'torch' for ~24h
# after a host reboot before being caught and fixed. Do not regress this.
# Cold-boot readiness gate (robustness -- this unit was NRestarts=0 at the
# reboot gate, but it shares the SAME two dependencies as the units that DID
# lose the boot race: the HackRF device and the backend API. Gate it on both
# for the same first-try-clean guarantee). Wait up to 60s for the HackRF USB
# device (non-claiming lsusb 1d50:6089 probe, never contends with
# cema-hackrf-rx) AND the backend on 127.0.0.1:8001 (curl WITHOUT -f, any HTTP
# response counts, no credentials needed). ALWAYS exit 0 after the timeout so
# an absent-hardware box still brings the unit up idle (the energy gate idles
# on no signal) rather than failing.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do lsusb -d 1d50:6089 >/dev/null 2>&1 && curl -s -o /dev/null http://127.0.0.1:8001/ && exit 0; sleep 1; done; exit 0'
ExecStart=/CEMA/joydipdemo/field-bridge/.venv/bin/python3 -u ml_classify_bridge.py
Restart=always
RestartSec=5
StandardOutput=append:/CEMA/joydipdemo/field-bridge/ml_classify_bridge.log
StandardError=append:/CEMA/joydipdemo/field-bridge/ml_classify_bridge.log

[Install]
WantedBy=multi-user.target

