[Unit]
Description=CEMA cUAS - passive HackRF/SiK detection bridge (RX only, no transmission)
After=network-online.target docker.service
Wants=network-online.target
# Restart-limit hardening (same rationale as cema-mavlink-sniffer.service,
# task #80): RX-only, no TX, nothing else depends on this holding a lock, so
# "keep retrying forever" through transient USB/SDR hiccups is the correct
# posture. Default StartLimitBurst=5/StartLimitIntervalSec=10s can trip
# permanently on a burst of quick HackRF re-enumeration attempts, requiring a
# manual reset-failed. Widen the window/burst and disable give-up behavior.
StartLimitIntervalSec=300
StartLimitBurst=20
StartLimitAction=none

[Service]
Type=simple
# Change these three (User/WorkingDirectory/EnvironmentFile path) to match your
# deployment — same convention as rf-bridge/cema-rf-bridge.service. There is
# deliberately only ONE copy of this unit in the repo; do not fork per-host
# copies with hardcoded paths/users baked in (that's what caused the previous
# rajtech/dinendu duplicate-and-drift problem). Keep host-specific values out
# of this file — they belong in the EnvironmentFile below.
User=biswajit
WorkingDirectory=/CEMA/joydipdemo/field-bridge

# Credentials and console URL are NOT hardcoded here. They are supplied via
# EnvironmentFile, which must define at minimum:
#   CEMA_API_URL=http://localhost:8001
#   CEMA_EMAIL=operator@meghaduta.mil
#   CEMA_PASSWORD=<this host's current admin password>
# Point this at either the project-root .env (same one docker-compose uses,
# which already carries ADMIN_EMAIL/ADMIN_PASSWORD per the Security Architect
# fix — map/copy those into CEMA_EMAIL/CEMA_PASSWORD) or a dedicated
# field-bridge/.env. This file must be created per-deployment; it is not
# committed to the repo. Restrict its permissions: chmod 600.
EnvironmentFile=/CEMA/joydipdemo/field-bridge/.env

ExecStart=/usr/bin/python3 -u hackrf_rx.py --interval-s 3
Restart=always
RestartSec=5
StandardOutput=append:/CEMA/joydipdemo/field-bridge/hackrf_rx.log
StandardError=append:/CEMA/joydipdemo/field-bridge/hackrf_rx.log

[Install]
WantedBy=multi-user.target
