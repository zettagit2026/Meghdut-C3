[Unit]
Description=CEMA cUAS - BENCH GATE: crsf_parser.py forensic decoder self-test (synthetic vectors, offline)
# DEPLOY-TIME BENCH GATE, not a live decoder. Runs the parser's own --self-test
# against hand-verified synthetic vectors and PASSES/FAILS on the exit code. NO
# credentials, NO EnvironmentFile: it must NEVER POST to the board or heartbeat,
# so it can never make a forensic entry look LIVE. This is the exact check
# cema-crsf-parser.service's HARDWARE STATUS note tells operators to run before
# enabling the live CRSF listener.
After=network-online.target

[Service]
Type=oneshot
User=biswajit
WorkingDirectory=/CEMA/joydipdemo/field-bridge
# NOTE: crsf_parser.py's self-test flag is --self-test (hyphenated), verified
# against its argparse definition. No EnvironmentFile on purpose (bench gate).
ExecStart=/CEMA/joydipdemo/field-bridge/.venv/bin/python3 -u crsf_parser.py --self-test
StandardOutput=append:/CEMA/joydipdemo/field-bridge/crsf_selftest.log
StandardError=append:/CEMA/joydipdemo/field-bridge/crsf_selftest.log

[Install]
WantedBy=multi-user.target
