[Unit]
Description=CEMA cUAS - GamutRF MQTT inference ingest adapter (RX only, no transmission, ADDITIONAL parallel signal path alongside ml_classify_bridge.py/hackrf_rx.py -- NOT a replacement)
After=network-online.target docker.service
Wants=network-online.target
# Restart-limit hardening (same rationale as cema-mavlink-sniffer.service,
# task #80): RX-only, no TX, nothing else depends on this holding a lock, so
# "keep retrying forever" through transient MQTT-broker/network hiccups is
# the correct posture. Default StartLimitBurst=5/StartLimitIntervalSec=10s
# can trip permanently, requiring a manual reset-failed. Widen the
# window/burst and disable give-up behavior. (Unit is currently not
# installed/enabled -- see note at bottom of file -- but hardened now so
# it's correct the moment it is.)
StartLimitIntervalSec=300
StartLimitBurst=20
StartLimitAction=none

[Service]
Type=simple
# Change these three (User/WorkingDirectory/EnvironmentFile path) to match your
# deployment — same convention as cema-ml-classify-bridge.service /
# cema-hackrf-rx.service. There is deliberately only ONE copy of this unit in
# the repo; do not fork per-host copies with hardcoded paths/users baked in.
# Keep host-specific values out of this file — they belong in the
# EnvironmentFile below.
User=biswajit
WorkingDirectory=/CEMA/joydipdemo/field-bridge

# Credentials and console URL are NOT hardcoded here. They are supplied via
# EnvironmentFile, which must define at minimum:
#   CEMA_API_URL=http://localhost:8001
#   CEMA_EMAIL=operator@meghaduta.mil
#   CEMA_PASSWORD=<this host's current admin password>
# Optional overrides (see gamutrf_backend_adapter.py module docstring for
# defaults and full explanation of each):
#   GAMUTRF_MQTT_HOST=localhost
#   GAMUTRF_MQTT_PORT=1883
#   GAMUTRF_MQTT_TOPIC=gamutrf/inference
#   GAMUTRF_INGEST_MIN_INTERVAL_S=2.0
# Point this at either the project-root .env or a dedicated field-bridge/.env.
# This file must be created per-deployment; it is not committed to the repo.
# Restrict its permissions: chmod 600.
EnvironmentFile=/CEMA/joydipdemo/field-bridge/.env

ExecStart=/usr/bin/python3 -u gamutrf_backend_adapter.py
Restart=always
RestartSec=5
StandardOutput=append:/CEMA/joydipdemo/field-bridge/gamutrf_backend_adapter.log
StandardError=append:/CEMA/joydipdemo/field-bridge/gamutrf_backend_adapter.log

[Install]
WantedBy=multi-user.target

