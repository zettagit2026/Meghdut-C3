# CEMA cUAS RF Bridge configuration
# Copy this to ".env" and edit for your rig.
#
# task #36 consolidation: this directory previously also ran a HackRF
# wide-band scanner (hackrf_scanner.py) with its own HACKRF_* sweep/gain/
# waterfall env vars. That scanner was a duplicate, earlier iteration of
# field-bridge/hackrf_rx.py and has been removed — HackRF detection config
# now lives in field-bridge/.env (or your project-root .env) instead. This
# file now only configures the MAVLink serial TX/RX bridge.

# --- App connection -----------------------------------------------------
# Where the CEMA cUAS backend is reachable from this host.
# If backend runs in Docker on the same box, use http://localhost:8001
# If backend is on another server, use http://<server>:8001
CEMA_API_URL=http://localhost:8001

# Operator credentials — bridge logs in and holds a JWT for REST + WS.
CEMA_EMAIL=operator@cema.mil
CEMA_PASSWORD=cema@2026

# Shared bridge-identity secret proving this process is a REAL TX bridge (not a
# browser/console session) when it advertises itself as the "mavlink" TX
# consumer via bridge_hello. Must equal the backend's CEMA_BRIDGE_TOKEN and the
# jam bridge's (field-bridge/.env). The backend validates it before trusting the
# self-advertisement, so a console session cannot forge a fake TX consumer to
# mask the "NO TX BRIDGE SUBSCRIBED" warning. Diagnostic-only — never gates TX.
# Leave unset to disable registration (backend then warns "no TX bridge").
CEMA_BRIDGE_TOKEN=

# --- MAVLink bridge (SiK / RFD900 / FPV telemetry radio) ----------------
MAVLINK_SERIAL=/dev/ttyUSB0
MAVLINK_BAUD=57600
# Set to 1 to also listen for MAVLink traffic FROM the drone and publish it
# as detections in the app.
MAVLINK_RX_ENABLED=1
